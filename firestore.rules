rules_version = '2';

// Kinara Family Clinic rules. Shapes match src/lib/records.ts and src/lib/doctors.ts; tested in tests/rules.test.ts.
//  - staff/{uid}:          who may sign in to the dashboard. role 'owner' = clinic admin (added in the Firebase
//                          console), role 'doctor' + doctorId = a doctor (added by the admin from the dashboard)
//  - doctors/{doctorId}:   public profile + schedule; visible to everyone only when active
//  - slots/{slotId}:       public "taken" markers (doctor, date, time only), so patients see free times
//  - bookings/{bookingId}: patient details: the admin sees all, a doctor only their own. Made online by patients,
//                          or by staff for phone calls / walk-ins (source). Consent is required either way.
//  - queues/{doctor_date}: token counter for one doctor's day (staff only)
//  - settings/clinic:      clinic-wide holidays (public read, admin write)
service cloud.firestore {
  match /databases/{database}/documents {

    function staffDoc(uid) { return /databases/$(database)/documents/staff/$(uid); }
    function doctorDoc(id) { return /databases/$(database)/documents/doctors/$(id); }
    function slotDoc(id) { return /databases/$(database)/documents/slots/$(id); }
    function bookingDoc(id) { return /databases/$(database)/documents/bookings/$(id); }
    function settingsDoc() { return /databases/$(database)/documents/settings/clinic; }

    function isMember() { return request.auth != null && exists(staffDoc(request.auth.uid)); }
    function me() { return get(staffDoc(request.auth.uid)).data; }
    function isAdmin() { return isMember() && me().role == 'owner'; }
    function isDoctor(id) { return isMember() && me().role == 'doctor' && me().doctorId == id; }

    function validWhen(d) {
      return d.doctorId is string && d.doctorId.matches('^[a-z][a-z-]{1,39}$')
        && d.date is string && d.date.matches('^20[0-9]{2}-[01][0-9]-[0-3][0-9]$')
        && d.time is string && d.time.matches('^[0-2][0-9]:[0-5][0-9]$');
    }

    function idFor(d) {
      return d.doctorId + '_' + d.date + '_' + d.time.replace(':', '');
    }

    function validDoctor(d) {
      return d.keys().hasOnly(['name', 'initials', 'speciality', 'about', 'experience', 'languages', 'leave', 'avatar',
                               'days', 'start', 'end', 'slotMinutes', 'active', 'order'])
        && d.keys().hasAll(['name', 'initials', 'speciality', 'about', 'experience', 'languages', 'leave', 'avatar',
                            'days', 'start', 'end', 'slotMinutes', 'active', 'order'])
        && d.name is string && d.name.size() >= 3 && d.name.size() <= 60
        && d.initials is string && d.initials.size() >= 1 && d.initials.size() <= 3
        && d.speciality is string && d.speciality.size() >= 1 && d.speciality.size() <= 60
        && d.about is string && d.about.size() <= 400
        && d.experience is int && d.experience >= 0 && d.experience <= 60
        && d.languages is list && d.languages.size() <= 6
        && d.leave is list && d.leave.size() <= 60
        && d.avatar is string && d.avatar.matches('^[a-z0-9-]{0,60}$')
        && d.days is list && d.days.size() >= 1 && d.days.size() <= 7
        && d.start is string && d.start.matches('^[0-2][0-9]:[0-5][0-9]$')
        && d.end is string && d.end.matches('^[0-2][0-9]:[0-5][0-9]$') && d.start < d.end
        && d.slotMinutes in [10, 15, 20, 30, 45, 60]
        && d.active is bool
        && d.order is int;
    }

    match /staff/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      // The admin can add doctors (never another owner). Owners are added only in the Firebase console.
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['role', 'doctorId', 'email'])
        && request.resource.data.role == 'doctor'
        && request.resource.data.doctorId is string
        && exists(doctorDoc(request.resource.data.doctorId))
        && request.resource.data.email is string && request.resource.data.email.size() <= 120;
      allow delete: if isAdmin() && resource.data.role == 'doctor';
      allow update: if false;
    }

    match /doctors/{doctorId} {
      allow read: if resource.data.active == true || isAdmin() || isDoctor(doctorId);
      allow create: if isAdmin() && doctorId.matches('^[a-z][a-z-]{1,39}$') && validDoctor(request.resource.data);
      // Doctors edit their own profile and leave days; schedule, publishing and order stay with the admin.
      allow update: if validDoctor(request.resource.data) && (
        isAdmin()
        || (isDoctor(doctorId) && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['name', 'initials', 'speciality', 'about', 'experience', 'languages', 'leave', 'avatar'])));
      allow delete: if isAdmin();
    }

    match /slots/{slotId} {
      allow read: if true;
      // Only together with its booking (same batch). A taken slot already exists, so it can't be created again.
      allow create: if request.resource.data.keys().hasOnly(['doctorId', 'date', 'time', 'bookingId'])
        && validWhen(request.resource.data)
        && slotId == idFor(request.resource.data)
        && request.resource.data.bookingId is string
        && existsAfter(bookingDoc(request.resource.data.bookingId))
        && getAfter(bookingDoc(request.resource.data.bookingId)).data.slotId == slotId;
      // Freed when the booking is cancelled (by the admin or that booking's doctor) or cleaned up.
      allow delete: if isAdmin() || isDoctor(resource.data.doctorId);
      allow update: if false;
    }

    function validBooking(d, bookingId) {
      return d.keys().hasOnly(['code', 'slotId', 'doctorId', 'date', 'time', 'name', 'phone', 'reason', 'status',
                               'source', 'token', 'consent', 'createdAt'])
        && d.keys().hasAll(['code', 'slotId', 'doctorId', 'date', 'time', 'name', 'phone', 'reason', 'status',
                            'source', 'token', 'consent', 'createdAt'])
        && validWhen(d)
        && d.slotId == idFor(d)
        && d.code is string && d.code.matches('^[A-Z]{2,5}-[0-9]{6}-[A-Z0-9]{4}$')
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && d.phone is string && d.phone.matches('^[6-9][0-9]{9}$')
        && d.reason is string && d.reason.size() <= 200
        && d.status == 'booked'
        && d.token == 0
        && d.consent == true
        && d.createdAt == request.time
        // the slot must be free now and claimed for this booking in the same batch
        && !exists(slotDoc(d.slotId))
        && existsAfter(slotDoc(d.slotId))
        && getAfter(slotDoc(d.slotId)).data.bookingId == bookingId;
    }

    function openForPatients(d) {
      return get(doctorDoc(d.doctorId)).data.active == true
        && !(d.date in get(doctorDoc(d.doctorId)).data.leave)
        && (!exists(settingsDoc()) || !(d.date in get(settingsDoc()).data.holidays));
    }

    match /bookings/{bookingId} {
      allow create: if validBooking(request.resource.data, bookingId) && (
        // patients online: only published doctors, not on leave days or clinic holidays
        (request.resource.data.source == 'online' && openForPatients(request.resource.data))
        // staff for a phone call or walk-in (the admin for anyone, a doctor for themselves)
        || (request.resource.data.source in ['phone', 'walkin']
            && (isAdmin() || isDoctor(request.resource.data.doctorId))));
      allow read: if isAdmin() || isDoctor(resource.data.doctorId);
      allow update: if (isAdmin() || isDoctor(resource.data.doctorId))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'token'])
        && request.resource.data.status in ['booked', 'arrived', 'completed', 'noshow', 'cancelled']
        && request.resource.data.token is int && request.resource.data.token >= 0;
      allow delete: if isAdmin();
    }

    match /queues/{queueId} {
      // queueId = doctorId_date; staff of that doctor (or the admin) hand out the day's tokens
      allow read: if isAdmin() || (isMember() && me().role == 'doctor' && queueId.matches(me().doctorId + '_.*'));
      allow create, update: if (isAdmin() || isDoctor(request.resource.data.doctorId))
        && request.resource.data.keys().hasOnly(['doctorId', 'date', 'next'])
        && queueId == request.resource.data.doctorId + '_' + request.resource.data.date
        && request.resource.data.next is int && request.resource.data.next >= 1;
      allow delete: if isAdmin();
    }

    match /settings/clinic {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['holidays'])
        && request.resource.data.holidays is list && request.resource.data.holidays.size() <= 120;
    }
  }
}
